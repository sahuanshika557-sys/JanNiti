# JanNiti AI Environment Configuration
# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000

# Client Port
VITE_PORT=5173

# Optional: Google Cloud / Firebase Settings (Default operates in resilient offline/local DB mode)
GOOGLE_CLOUD_PROJECT=janniti-ai-dpg
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
